# Trading mode: PAPER | SHADOW | LIVE
TRADING_MODE=PAPER

# NEVER commit real keys. Use a secrets manager in production.
WALLET_PUBLIC_KEY=

# Provider API keys
HELIUS_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=

# Database
DATABASE_URL=postgresql://trader:trader@localhost:5432/trader

# Redis
REDIS_URL=redis://localhost:6379

# Risk limits
MAX_DAILY_LOSS_USD=100
MAX_DRAWDOWN_PCT=10
MAX_POSITION_VALUE_USD=500
MAX_CONCURRENT_POSITIONS=5
MIN_LIQUIDITY_USD=50000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
