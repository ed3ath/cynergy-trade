# Trading mode: PAPER | SHADOW | LIVE
TRADING_MODE=PAPER

# NEVER commit real keys. Use a secrets manager in production.
WALLET_PUBLIC_KEY=

# Provider API keys
HELIUS_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=

# Database
DATABASE_URL=postgresql://trader:trader@localhost:5432/trader

# Redis
REDIS_URL=redis://localhost:6379

# Risk limits
MAX_DAILY_LOSS_USD=100
MAX_DRAWDOWN_PCT=10
MAX_POSITION_VALUE_USD=500
MAX_CONCURRENT_POSITIONS=5
MIN_LIQUIDITY_USD=50000
# Max total USD the bot may take from the wallet at once (sum of open positions)
MAX_TOTAL_EXPOSURE_USD=2000

# Trader HTTP server. Must match the port the watchdog daemon health-checks
# (MONITOR_PORT, default 3000) — changing only one makes the daemon respawn forever.
SERVER_PORT=3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# AI agent (optional — any OpenAI-compatible /chat/completions endpoint)
AI_ENABLED=false
# off = agent dead · veto = second opinion on strategy candidates (default) ·
# auto = autonomous trader: ENTER/EXIT/TIGHTEN actions, every entry still
# risk-engine gated, exits only ever tightenable (never widenable)
AI_AUTONOMY=veto
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Blended USD per 1k tokens — 0 disables the daily cap below
AI_COST_PER_1K_TOKENS_USD=0
AI_MAX_COST_PER_DAY_USD=5
AI_TIMEOUT_MS=8000
AI_TOOLS=true
# Autonomous mode (AI_AUTONOMY=auto) tuning
AI_CYCLE_SEC=60
AI_MAX_ACTIONS_PER_CYCLE=3
AI_MAX_OPEN_POSITIONS=3
AI_TOKEN_COOLDOWN_SEC=600
# Cheap opt-out: AI stays silent in LIVE mode when false
AI_LIVE_ENABLED=true

# Jev-ai second opinion (jev-ai.pro; auto mode) — classifier pre-filter +
# ENTER confidence damper. Empty key = disabled; Jev failures = pass-through.
JEV_API_KEY=
# Base URL (`/systemone` appended) — point at a local gateway to proxy Jev
JEV_BASE_URL=https://jev-ai.pro/api/v1
JEV_MODEL=jev-latest
# Drop candidates scoring below this P(entry)
JEV_MIN_SCORE=0.5
JEV_TIMEOUT_MS=5000

# Copy-trade tracked wallets (TON-only; requires AI_ENABLED + AI_AUTONOMY=veto|auto)
# veto: fresh tracked BUYs are copied after the AI veto agent's review
# auto: tracked swaps feed the AI trader, which decides entries + take-profit
# Wallets: comma list, optional ":label" — pick high-PNL traders (tonviewer etc.)
COPYTRADE_ENABLED=false
#COPYTRADE_WALLETS=EQ...:whale1,0:abc123def...:sniper2
# Entry profile: scalp (SL 5% / TP 3–6% / 20min hold) | shortterm (SL 10% / TP 5–10% / 2h)
COPYTRADE_PROFILE=shortterm
COPYTRADE_POLL_SEC=30
COPYTRADE_MAX_SLOTS_PER_TOKEN=2
COPYTRADE_MAX_POSITIONS=3
COPYTRADE_MAX_SIGNAL_AGE_SEC=600
