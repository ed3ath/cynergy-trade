{
  "name": "autonomous-trader",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "tsx infra/scripts/migrate.mts",
    "db:seed": "tsx infra/scripts/seed.ts",
    "claude": "claude --dangerously-skip-permissions",
    "phase:status": "tsx infra/scripts/phase-status.mts"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "@autonomous-trader/providers": "workspace:*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@solana/kit": "^8.3.0",
    "@solana/web3.js": "^1.99.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  }
}
