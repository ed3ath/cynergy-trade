# ─── Trading ───────────────────────────────────────────────────────────────────
# PAPER | SHADOW | LIVE. LIVE is refused at boot without WALLET_PRIVATE_KEY.
TRADING_MODE=PAPER

# ─── Wallet (LIVE only) ───────────────────────────────────────────────────────
# Base58 secret key (Phantom export) or JSON byte array (solana-keygen).
# Fund this LIMITED trading wallet only — never the treasury (spec §34).
WALLET_PRIVATE_KEY=
WALLET_PUBLIC_KEY=

# ─── Providers ────────────────────────────────────────────────────────────────
HELIUS_API_KEY=
BIRDEYE_API_KEY=
# GoPlus is public — no key needed.
# Without Helius: set true to discover via public RPC (rate-limited, dev only)
ENABLE_PUBLIC_DISCOVERY=false

# ─── Ops ──────────────────────────────────────────────────────────────────────
MONITOR_TOKEN=            # required for emergency HTTP POSTs — generate a strong token
SERVER_PORT=3000
LOG_LEVEL=info
LOG_PRETTY=false

# ─── Alerting (spec §65) ──────────────────────────────────────────────────────
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ─── Risk limits (defaults sane for micro-capital; tune deliberately) ────────
MAX_DAILY_LOSS_USD=100
MAX_WEEKLY_LOSS_USD=300
MAX_DRAWDOWN_PCT=10
MAX_DRAWDOWN_EMERGENCY_PCT=20
BASE_RISK_PCT=0.5
MAX_POSITION_VALUE_USD=500
MAX_CONCURRENT_POSITIONS=5
# Max total USD the bot may take from the wallet at once (sum of open positions)
MAX_TOTAL_EXPOSURE_USD=2000
MIN_LIQUIDITY_USD=50000
MAX_SLIPPAGE_BPS=300

# ─── Portfolio ────────────────────────────────────────────────────────────────
# Starting capital of the paper/live book (mark-to-market baseline; persisted once)
STARTING_CAPITAL_USD=10000

# ─── Infra (compose supplies these; shown for reference) ─────────────────────
# DATABASE_URL=postgresql://trader:trader@postgres:5432/trader
# REDIS_URL=redis://redis:6379
#   ^ UNCOMMENT for deployment: enables the Redis idempotency guard.
#     LIVE mode refuses to boot without a reachable Redis (Phase D gate);
#     paper/shadow fall back to the Postgres guard when Redis is absent.
POSTGRES_PASSWORD=change-me
